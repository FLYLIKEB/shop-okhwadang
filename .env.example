BACKEND_URL=http://localhost:3000
# Checkout exposure single source: backend/src/config/checkout-gateway-contract.ts
NEXT_PUBLIC_CHECKOUT_ENABLED_GATEWAYS=toss,paypal,eximbay  # ko: Toss widget only, en: PayPal/Eximbay
NEXT_PUBLIC_TOSS_CLIENT_KEY=  # Legacy preview setting; checkout uses the backend prepare response client key
NEXT_PUBLIC_TOSS_PAYMENT_VARIANT_KEY=  # Optional merchant payment UI key; empty uses DEFAULT
NEXT_PUBLIC_TOSS_AGREEMENT_VARIANT_KEY=  # Optional merchant agreement UI key; empty uses default Korean UI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # Stripe publishable key (for global locale)
NEXT_PUBLIC_KAKAO_CLIENT_ID=  # REQUIRED — Kakao JavaScript/REST app key used to build OAuth authorize URL
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback  # REQUIRED — must match Kakao Developers redirect URI
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# PayPal uses backend-created Orders API redirect flow; no frontend SDK key is required.

# Naver Commerce API sync is executed by the backend; frontend keeps key names only for setup visibility.
NAVER_COMMERCE_APP_ID=
NAVER_COMMERCE_APP_SECRET=
